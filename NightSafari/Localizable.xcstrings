    },
    "error.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could Not Open Privately" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法以私密瀏覽開啟" } }
