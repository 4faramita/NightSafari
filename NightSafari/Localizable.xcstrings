      }
    },
    "settings.automationDeniedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow NightSafari to control Safari in System Settings, then retry." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請在「系統設定」中允許 NightSafari 控制 Safari，然後重試。" } }
      }
    },
    "settings.automationGrantedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "NightSafari is allowed to load links into Safari." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "NightSafari 已可將連結載入 Safari。" } }
      }
    },
    "settings.automationNotRequested" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Request access here first. NightSafari appears in Automation settings only after macOS has asked for permission." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先在這裡要求權限。macOS 顯示權限提示後，NightSafari 才會出現在「自動化」設定中。" } }
      }
    },
    "settings.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Each group of links opens in a newly created private Safari window. Existing Safari windows and tabs are never closed." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每組連結都會在新建立的 Safari 私密瀏覽視窗中開啟。現有的 Safari 視窗與分頁不會被關閉。" } }
      }
    },
