    },
    "error.safariUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Safari could not be found on this Mac." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這台 Mac 上找不到 Safari。" } }
